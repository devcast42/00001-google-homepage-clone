{
  "name": "docseek",
  "private": true,
  "description": "Motor de búsqueda de documentación técnica: rastreador, índice BM25F propio, API y frontend en TypeScript.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @docseek/web",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && npm run typecheck -w @docseek/web",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "crawl": "npm run crawl -w @docseek/crawler --",
    "index": "npm run index -w @docseek/crawler --",
    "dev": "npm run index && concurrently -n api,web -c blue,magenta \"npm run dev -w @docseek/api\" \"npm run dev -w @docseek/web\"",
    "start": "node apps/api/dist/server.js",
    "clean": "tsc -b --clean && rm -rf apps/web/dist data/index.json",
    "bench:relevance": "tsx --conditions=source bench/relevance.ts",
    "bench:latency": "tsx --conditions=source bench/latency.ts",
    "bench:tune": "tsx --conditions=source bench/tune.ts",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
